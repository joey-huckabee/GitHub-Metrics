# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# Personal access token used for all GitHub API calls.
# Create one at https://github.com/settings/tokens
# A classic token needs `public_repo` (or `repo` for private repositories).
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Optional: point at GitHub Enterprise instead of github.com.
# GITHUB_API_URL=https://github.example.com/api/v3

# Optional: User-Agent sent to the Nominatim geocoder (geopy).
GEOCODER_USER_AGENT=github-metrics

# Optional: where resolved contributor locations are remembered between runs.
# Defaults to the platform cache directory (%LOCALAPPDATA%\github-metrics on
# Windows, $XDG_CACHE_HOME or ~/.cache elsewhere). Set it to an empty value to
# turn persistence off. Deleting the file costs time and loses no measurement.
# GEOCODE_CACHE_PATH=

# Optional: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
