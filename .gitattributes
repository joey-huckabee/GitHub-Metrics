# Every text file is stored and checked out with LF, on every platform.
# Without this, editors and tooling on Windows silently commit CRLF and turn
# a one-line change into a whole-file rewrite in review.
* text=auto eol=lf

# Explicit types, so nothing depends on content auto-detection.
*.py     text eol=lf diff=python
*.pyi    text eol=lf diff=python
*.toml   text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf
*.md     text eol=lf diff=markdown
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.sh     text eol=lf
Makefile text eol=lf

# Never normalise these.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.whl  binary

# Collapse the lockfile in review; it is generated, not authored.
poetry.lock linguist-generated=true
