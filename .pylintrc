[MAIN]
py-version = 3.10
jobs = 0
ignore-paths = ^\.venv/.*$
load-plugins =
    pylint.extensions.docparams,
    pylint.extensions.no_self_use

[MESSAGES CONTROL]
# Disabled where black / ruff / mypy already own the concern, plus a few
# rules that fight normal application code.
disable =
    line-too-long,
    wrong-import-order,
    ungrouped-imports,
    missing-type-doc,
    missing-return-type-doc,
    too-few-public-methods,
    duplicate-code,
    fixme,
    # A pytest fixture is consumed by a parameter of the same name, so
    # every test using a locally-defined fixture trips this.
    redefined-outer-name

[FORMAT]
max-line-length = 100

[BASIC]
good-names = i, j, k, n, x, y, db, id, ok, pr, gh, _
# Private helpers, test cases, and pytest fixtures document themselves by name.
no-docstring-rgx = ^(_|test_)

[DESIGN]
max-args = 8
# click invokes command callbacks with keyword arguments, so the positional
# limit does not describe how these functions are actually called.
max-positional-arguments = 8
max-attributes = 16
# Same reason as the argument limits above: a click command's parameters are
# one per flag and count as locals, so `scan` reads as 21 while assigning
# seven. The limit is meant to catch a function doing too much, and counting
# the command line as complexity does not measure that.
max-locals = 24
# `cli.py` is long because it explains itself: 22 functions, the longest 101
# lines, 78 comment-only lines, and no branching worth splitting. The one
# split that was worth making - `exit_codes.py` in v0.6.3 - was made because
# the exit-status scheme had no owner and that absence was a defect, not
# because of a line count. A further split needs a reason of that kind. This
# ceiling exists to make the next person argue for one, not to be raised
# again quietly.
max-module-lines = 1100

[REPORTS]
score = no
